# Copy to .env and fill in. Never commit .env.

# Tatum: https://dashboard.tatum.io (free account). Header: x-api-key
TATUM_API_KEY=
# Website only: daily Tatum credit budget per server instance (each request counted at its listed price)
# TATUM_DAILY_CREDITS=150000

# Walrus Memory MAINNET: https://memory.walrus.xyz/dashboard
# Create an agent, then a delegate key.
MEMWAL_PRIVATE_KEY=            # delegate private key (server only)
MEMWAL_ACCOUNT_ID=0x...        # MemWalAccount object ID (not your wallet address)
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Later (day 3+)
DATABASE_URL=
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ODDS_API_KEY=

# Paid X-ray API (MPP on Sui), see docs/AGENT_PAYMENTS.md. Server side (apps/web/.env.local or the Vercel project):
MPP_RECIPIENT=0x...            # Sui address that receives the USDC
MPP_SECRET_KEY=                # openssl rand -base64 32 (at least 32 bytes)
# MPP_DIGEST_FILE=             # optional: keeps spent payment digests across restarts
# Buyer agent demo (scripts/agent-pay-demo.ts): a fresh key holding about 0.10 USDC and 0.1 SUI on mainnet
AGENT_SUI_KEY=                 # suiprivkey1...
