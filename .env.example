# Copy to .env and fill in. Never commit .env.

# Tatum: https://dashboard.tatum.io (free account). Header: x-api-key
TATUM_API_KEY=
# Spending budgets. Set the PLAN and the rest is worked out from it (packages/chain/src/credits.ts); each request is
# counted at Tatum's listed credit price, not as "one call". Measure the real costs with:
#   node node_modules/tsx/dist/cli.mjs scripts/tatum-cost-model.ts --no-probe --allowance 2000000 --days 11
# free (100,000 lifetime, the default) gives the site 1,000 credits a day: enough to prove the integration, not to serve
# traffic. starter (4,000,000 a month) gives it 267,000 a day. Use TATUM_PLAN_CREDITS for a share of a plan split with
# someone else, e.g. 2000000 for half: that yields 122,000 a day for the site and 317,746 for the watcher.
# TATUM_PLAN=free
# TATUM_PLAN_CREDITS=2000000
# TATUM_BUDGET_DAYS=11
# Either of these overrides the worked-out value, if you want to set one by hand:
# TATUM_DAILY_CREDITS=122000
# TATUM_CREDIT_BUDGET=317746

# Walrus Memory MAINNET: https://memory.walrus.xyz/dashboard
# Create an agent, then a delegate key.
MEMWAL_PRIVATE_KEY=            # delegate private key (server only)
MEMWAL_ACCOUNT_ID=0x...        # MemWalAccount object ID (not your wallet address)
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz

# Later (day 3+)
DATABASE_URL=
NEXT_PUBLIC_ENOKI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
ODDS_API_KEY=

# Paid X-ray API (MPP on Sui), see docs/AGENT_PAYMENTS.md. Server side (apps/web/.env.local or the Vercel project):
MPP_RECIPIENT=0x...            # Sui address that receives the USDC
MPP_SECRET_KEY=                # openssl rand -base64 32 (at least 32 bytes)
# MPP_DIGEST_FILE=             # optional: keeps spent payment digests across restarts
# Buyer agent demo (scripts/agent-pay-demo.ts): a fresh key holding about 0.10 USDC and 0.1 SUI on mainnet
AGENT_SUI_KEY=                 # suiprivkey1...
